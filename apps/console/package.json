{
    "name": "@syaroio/remake",
    "type": "module",
    "version": "3.0.1",
    "author": "Vick Scarlet <vick@syaro.io>",
    "bin": {
        "remake": "dist/index.js"
    },
    "publishConfig": {
        "access": "public"
    }, 
    "repository": {
        "type": "git",
        "url": "git+https://github.com/VickScarlet/remake.git",
    },
    "scripts": {
        "dev": "bun --watch --watch-dir=src run src/index.tsx",
        "build": "bun build src/index.tsx --outdir dist --bundle --target=node",
        "start": "bun run src/index.tsx",
        "lint": "bunx --bun eslint .",
        "test": "bun test"
    },
    "devDependencies": {
        "@remake/data": "workspace:*",
        "@remake/hooks": "workspace:*",
        "@remake/vitex": "workspace:*",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "ink": "^8.0.0",
        "ink-scroll-view": "^0.4.0",
        "jotai": "^3.0.1",
        "react": "^19.3.0",
        "react-devtools-core": "^8.0.0"
    },
    "files": [
        "dist"
    ]
}
