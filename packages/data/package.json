{
    "name": "@remake/data",
    "type": "module",
    "version": "3.0.0",
    "main": "src/index.ts",
    "author": "Vick Scarlet <vick@syaro.io>",
    "scripts": {
        "build": "bunx --bun v-transform transform -t ts -w src -d dist \"**/[!~$]*.xlsx\" --map",
        "lint": "bunx --bun eslint .",
        "test": "bun test"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts"
        },
        "./*": {
            "types": "./dist/*.ts",
            "import": "./dist/*.ts"
        }
    }
}
