{
  "name": "remake",
  "type": "module",
  "version": "3.0.0",
  "author": "Vick Scarlet <vick@syaro.io>",
  "scripts": {
    "dev": "pnpm --filter @remake/web dev",
    "dev:console": "pnpm --filter @syaroio/remake dev",
    "dev:prod": "pnpm --filter @remake/web dev:prod",
    "build:console": "pnpm --filter @syaroio/remake build",
    "build:web": "pnpm --filter @remake/web build",
    "build:bili": "pnpm --filter @remake/web build:bili",
    "build:data": "pnpm --filter @remake/data build",
    "preview": "pnpm --filter @remake/web preview",
    "start": "pnpm --filter @syaroio/remake start",
    "lint": "bunx --bun eslint",
    "lint:console": "pnpm --filter @syaroio/remake lint",
    "lint:web": "pnpm --filter @remake/web lint",
    "lint:core": "pnpm --filter @remake/core lint",
    "lint:data": "pnpm --filter @remake/data lint",
    "lint:condition": "pnpm --filter @remake/condition lint",
    "lint:hooks": "pnpm --filter @remake/hooks lint",
    "fix": "bunx --bun eslint --fix",
    "fix:console": "pnpm --filter @syaroio/remake lint --fix",
    "fix:web": "pnpm --filter @remake/web lint --fix",
    "fix:core": "pnpm --filter @remake/core lint --fix",
    "fix:data": "pnpm --filter @remake/data lint --fix",
    "fix:condition": "pnpm --filter @remake/condition lint --fix",
    "fix:hooks": "pnpm --filter @remake/hooks lint --fix",
    "test": "pnpm --filter @remake/web test",
    "test:console": "pnpm --filter @syaroio/remake test",
    "test:web": "pnpm --filter @remake/web test",
    "test:core": "pnpm --filter @remake/core test",
    "test:data": "pnpm --filter @remake/data test",
    "test:condition": "pnpm --filter @remake/condition test",
    "test:hooks": "pnpm --filter @remake/hooks test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "thirdparty/*"
  ]
}
